{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memorywholed",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Serve the built SPA as static assets. Unknown paths fall back to index.html
  // so client-side routes (e.g. /decks/123) survive a hard refresh.
  // Only /api/* reaches the Worker script.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Per-client throttle for the AI endpoint so a public workers.dev URL can't
  // burn through the Gemini quota. The Worker skips it gracefully if absent.
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.1-flash-lite-preview"
  }
  // Secret (not committed): npx wrangler secret put GEMINI_API_KEY
}
